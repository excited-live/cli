{
	"name": "@excited-live/cli",
	"version": "0.0.0",
	"private": true,
	"description": "excited.live command line",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"bin": {
		"excited": "./src/index.ts"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"build": "bun build src/index.ts --compile --outfile dist/excited",
		"check": "bun run typecheck && bun test && bun run build"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"typescript": "^5.8.3"
	}
}
